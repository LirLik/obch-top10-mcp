{
  "name": "obch-top10-mcp",
  "version": "1.1.0",
  "description": "Единый сервис: сайт Топ-10 + API + MCP + MariaDB для obch",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "obch-top10-mcp": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "web": "node src/server.js",
    "stdio": "node src/stdio.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:import-json": "node scripts/import-json.mjs",
    "postinstall": "prisma generate",
    "inspect": "npx @modelcontextprotocol/inspector node src/stdio.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@prisma/client": "^6.12.0",
    "express": "^5.2.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "prisma": "^6.12.0"
  }
}
